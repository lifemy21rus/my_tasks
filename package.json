{
  "name": "my-tasks",
  "productName": "Планировщик",
  "version": "1.0.3",
  "description": "Локальный планировщик задач для Windows",
  "main": "src/main/main.js",
  "author": "MyTasks",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/basic.test.js",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "fmt": "prettier --write \"src/**/*.{js,html,css}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "fmt:check": "prettier --check \"src/**/*.{js,html,css}\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "playwright": "^1.49.0",
    "@playwright/test": "^1.49.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
